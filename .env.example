# Database
DATABASE_URL="mysql://user:password@localhost:3306/ufo_networks"

# Session (required in production)
NUXT_SESSION_PASSWORD="change-me-to-a-long-random-string"

# Public base URL of the site (REQUIRED in production).
# Paynow return/result URLs are built from this. If it is unset in production the app
# would fall back to the request Host header, which the reverse proxy rewrites to
# 127.0.0.1:3000 - sending paying customers to a dead address.
NUXT_PUBLIC_SITE_URL="https://www.ufonetworks.org"

# Paynow (required for voucher payments)
PAYNOW_INTEGRATION_ID=""
PAYNOW_INTEGRATION_KEY=""
# Merchant email registered with Paynow (recommended for live/test payments)
PAYNOW_AUTH_EMAIL=""

# Alternative Nuxt-prefixed names (also supported)
# NUXT_PAYNOW_INTEGRATION_ID=""
# NUXT_PAYNOW_INTEGRATION_KEY=""
# NUXT_PAYNOW_AUTH_EMAIL=""

# Mailtrap (Transactional Email)
# Set this to your Mailtrap API token.
MAILTRAP_TOKEN=""

# Where contact form emails should be delivered
CONTACT_ADMIN_EMAIL="support@ufo-networks.org"

# The sender address used in outgoing transactional emails
SENDER_EMAIL="noreply@ufo-networks.org"
